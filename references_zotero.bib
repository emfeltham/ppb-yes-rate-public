@article{macmillan_response_1990,
  title = {Response Bias: {{Characteristics}} of Detection Theory, Threshold Theory, and "Nonparametric" Indexes},
  shorttitle = {Response Bias},
  author = {Macmillan, Neil A. and Creelman, C. Douglas},
  date = {1990},
  journaltitle = {Psychological Bulletin},
  shortjournal = {Psychol. Bull.},
  volume = {107},
  number = {3},
  pages = {401--413},
  publisher = {American Psychological Association},
  location = {US},
  issn = {1939-1455},
  doi = {10.1037/0033-2909.107.3.401},
  abstract = {Models of discrimination based on statistical decision theory distinguish sensitivity (the ability of an observer to reflect a stimulus–response correspondence defined by the experimenter) from response bias (the tendency to favor 1 response over others). Measures of response bias have received less attention than those of sensitivity. Bias measures are classified here according to 2 characteristics. First, the distributions assumed or implied to underlie the observer's decision may be normal, logistic, or rectangular. Second, the bias index may measure criterion location, criterion location relative to sensitivity, or likelihood ratio. Both parametric and "nonparametric" indexes are classified in this manner. The various bias statistics are compared on pragmatic and theoretical grounds, and it is concluded that criterion measures have many advantages in empirical work. (PsycInfo Database Record (c) 2025 APA, all rights reserved)},
  keywords = {Response Bias}
}

