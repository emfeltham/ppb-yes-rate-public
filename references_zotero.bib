@article{stretch_difference_1998,
  title = {On the Difference between Strength-Based and Frequency-Based Mirror Effects in Recognition Memory},
  author = {Stretch, Vincent and Wixted, John T.},
  date = {1998},
  journaltitle = {Journal of Experimental Psychology: Learning, Memory, and Cognition},
  shortjournal = {J. Exp. Psychol. Learn. Mem. Cogn.},
  volume = {24},
  number = {6},
  pages = {1379--1396},
  publisher = {American Psychological Association},
  location = {US},
  issn = {1939-1285},
  doi = {10.1037/0278-7393.24.6.1379},
  abstract = {A mirror effect can be produced by manipulating word class (e.g., high vs. low frequency) or by manipulating strength (e.g., short vs. long study time). The results of 5 experiments reported here suggest that a strength-based mirror effect is caused by a shift in the location of the decision criterion, whereas a frequency-based mirror effect occurs although the criterion remains fixed with respect to word frequency. Evidence supporting these claims is provided by a series of studies in which high frequency (HF) words were differentially strengthened (and sometimes differentially colored) during list presentation. That manipulation increased the HF hit rate above that for low frequency (LF) words without selectively decreasing the HF false alarm rate, just as a fixed-criterion account of the word-frequency mirror effect predicts. (PsycInfo Database Record (c) 2026 APA, all rights reserved)},
  keywords = {Memory,Recognition (Learning),Recognition Memory,Stimulus Parameters,Word Recognition}
}

